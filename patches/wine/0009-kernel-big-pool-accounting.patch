     switch (class)
     {
 
+    case SystemBigPoolInformation:
+    {
+        SYSTEM_BIGPOOL_INFORMATION *pool = info;
+        struct kernel_big_pool *entries;
+        unsigned int count = 0, copied = 0, i, capacity;
+
+        if (size && !virtual_check_buffer_for_write( info, size )) return STATUS_ACCESS_VIOLATION;
+        len = sizeof(*pool);
+        if (size < len)
+        {
+            ret = STATUS_INFO_LENGTH_MISMATCH;
+            break;
+        }
+        capacity = (size - offsetof(SYSTEM_BIGPOOL_INFORMATION, AllocatedInfo)) / sizeof(SYSTEM_BIGPOOL_ENTRY);
+        if (!(entries = malloc( capacity * sizeof(*entries) ))) return STATUS_NO_MEMORY;
+        SERVER_START_REQ( get_kernel_big_pools )
+        {
+            wine_server_set_reply( req, entries, capacity * sizeof(*entries) );
+            ret = wine_server_call( req );
+            count = reply->count;
+            copied = wine_server_reply_size( reply ) / sizeof(*entries);
+        }
+        SERVER_END_REQ;
+        if (!ret || ret == STATUS_INFO_LENGTH_MISMATCH)
+        {
+            len = max( sizeof(*pool), offsetof(SYSTEM_BIGPOOL_INFORMATION, AllocatedInfo) + count * sizeof(SYSTEM_BIGPOOL_ENTRY) );
+            memset( pool, 0, min(size, len) );
+            pool->Count = count;
+            for (i = 0; i < copied; ++i)
+            {
+                pool->AllocatedInfo[i].VirtualAddress = (void *)((ULONG_PTR)entries[i].address | !!entries[i].nonpaged);
+                pool->AllocatedInfo[i].SizeInBytes = entries[i].size;
+                pool->AllocatedInfo[i].TagUlong = entries[i].tag;
+            }
+        }
+        free( entries );
+        break;
+    }
     case SystemPoolTagInformation:
     {
         SYSTEM_POOLTAG_INFORMATION *pool = info;
