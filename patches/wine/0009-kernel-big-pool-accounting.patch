     allocation->tag = tag;
     allocation->paged = !!req->paged;
+    allocation->large = !!req->large;
     list_add_tail( &kernel_pool_allocations, &allocation->entry );
     if (allocation->paged)
     {
@@ -2168,3 +2170,35 @@
     }
     if (capacity < count) set_error( STATUS_INFO_LENGTH_MISMATCH );
 }
+
+
+DECL_HANDLER(get_kernel_big_pools)
+{
+    struct kernel_pool_allocation *allocation;
+    struct kernel_big_pool *buffer;
+    unsigned int count = 0, capacity, copied = 0;
+
+    LIST_FOR_EACH_ENTRY( allocation, &kernel_pool_allocations, struct kernel_pool_allocation, entry )
+        if (allocation->large) count++;
+    reply->count = count;
+    capacity = min( count, get_reply_max_size() / sizeof(*buffer) );
+    if (capacity)
+    {
+        if (!(buffer = set_reply_data_size( capacity * sizeof(*buffer) ))) return;
+        LIST_FOR_EACH_ENTRY( allocation, &kernel_pool_allocations, struct kernel_pool_allocation, entry )
+        {
+            if (!allocation->large) continue;
+            buffer[copied].address = allocation->address;
+            buffer[copied].size = allocation->size;
+            buffer[copied].tag = allocation->tag->stats.tag;
+            buffer[copied].nonpaged = !allocation->paged;
+            if (++copied == capacity) break;
+        }
+    }
+    if (capacity < count) set_error( STATUS_INFO_LENGTH_MISMATCH );
+}
+
+DECL_HANDLER(clear_kernel_pools)
+{
+    cleanup_kernel_pools( current->process );
+}
