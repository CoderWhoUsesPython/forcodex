Subject: [PATCH] Report and account page-backed large kernel pool allocations.

Implement SystemBigPoolInformation from real Wine kernel pool allocations.
Page-align and separately back large blocks; preserve executable/NX pool types.
Release all accounting on explicit ntoskrnl unload as well as process exit.

--- a/include/winternl.h
+++ b/include/winternl.h
@@ -3035,6 +3035,20 @@
     ULONG Count;
     SYSTEM_POOLTAG TagInfo[1];
 } SYSTEM_POOLTAG_INFORMATION, *PSYSTEM_POOLTAG_INFORMATION;
+
+/* System Information Class 0x42 */
+typedef struct _SYSTEM_BIGPOOL_ENTRY
+{
+    union { PVOID VirtualAddress; ULONG_PTR NonPaged : 1; };
+    SIZE_T SizeInBytes;
+    union { UCHAR Tag[4]; ULONG TagUlong; };
+} SYSTEM_BIGPOOL_ENTRY, *PSYSTEM_BIGPOOL_ENTRY;
+
+typedef struct _SYSTEM_BIGPOOL_INFORMATION
+{
+    ULONG Count;
+    SYSTEM_BIGPOOL_ENTRY AllocatedInfo[1];
+} SYSTEM_BIGPOOL_INFORMATION, *PSYSTEM_BIGPOOL_INFORMATION;
 
 /* System Information Class 0x10 */
 
