+
+
+struct kernel_pool_stats
+{
+    struct list entry;
+    struct kernel_pool_tag stats;
+};
+
+struct kernel_pool_allocation
+{
+    struct list entry;
+    struct process *owner;
+    client_ptr_t address;
+    mem_size_t size;
+    struct kernel_pool_stats *tag;
+    int paged;
+};
+
+static struct list kernel_pool_tags = LIST_INIT(kernel_pool_tags);
+static struct list kernel_pool_allocations = LIST_INIT(kernel_pool_allocations);
+
+static void release_kernel_pool( struct kernel_pool_allocation *allocation )
+{
+    struct kernel_pool_tag *tag = &allocation->tag->stats;
+    if (allocation->paged)
+    {
+        tag->paged_frees++;
+        tag->paged_used -= allocation->size;
+    }
+    else
+    {
+        tag->nonpaged_frees++;
+        tag->nonpaged_used -= allocation->size;
+    }
+    list_remove( &allocation->entry );
+    free( allocation );
+}
+
+static void cleanup_kernel_pools( struct process *process )
+{
+    struct kernel_pool_allocation *allocation, *next;
+    LIST_FOR_EACH_ENTRY_SAFE( allocation, next, &kernel_pool_allocations,
+                              struct kernel_pool_allocation, entry )
+        if (allocation->owner == process) release_kernel_pool( allocation );
+}
+
+DECL_HANDLER(update_kernel_pool)
+{
+    struct kernel_pool_allocation *allocation;
+    struct kernel_pool_stats *tag;
+
+    if (!req->address)
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    if (!req->allocate)
+    {
+        LIST_FOR_EACH_ENTRY( allocation, &kernel_pool_allocations, struct kernel_pool_allocation, entry )
+            if (allocation->owner == current->process && allocation->address == req->address)
+            {
+                release_kernel_pool( allocation );
+                return;
+            }
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    if (!(allocation = mem_alloc( sizeof(*allocation) ))) return;
+    LIST_FOR_EACH_ENTRY( tag, &kernel_pool_tags, struct kernel_pool_stats, entry )
+        if (tag->stats.tag == req->tag) goto found;
+    if (!(tag = mem_alloc( sizeof(*tag) )))
+    {
+        free( allocation );
+        return;
+    }
+    memset( &tag->stats, 0, sizeof(tag->stats) );
+    tag->stats.tag = req->tag;
+    list_add_tail( &kernel_pool_tags, &tag->entry );
+found:
+    allocation->owner = current->process;
+    allocation->address = req->address;
+    allocation->size = req->size;
+    allocation->tag = tag;
+    allocation->paged = !!req->paged;
+    list_add_tail( &kernel_pool_allocations, &allocation->entry );
+    if (allocation->paged)
+    {
+        tag->stats.paged_allocs++;
+        tag->stats.paged_used += allocation->size;
+    }
+    else
+    {
+        tag->stats.nonpaged_allocs++;
+        tag->stats.nonpaged_used += allocation->size;
+    }
+}
+
+DECL_HANDLER(get_kernel_pool_tags)
+{
+    struct kernel_pool_stats *tag;
+    struct kernel_pool_tag *buffer;
+    unsigned int count = 0, copied = 0, capacity;
+
+    LIST_FOR_EACH_ENTRY( tag, &kernel_pool_tags, struct kernel_pool_stats, entry ) count++;
+    reply->count = count;
+    capacity = min( count, get_reply_max_size() / sizeof(*buffer) );
+    if (capacity)
+    {
+        if (!(buffer = set_reply_data_size( capacity * sizeof(*buffer) ))) return;
+        LIST_FOR_EACH_ENTRY( tag, &kernel_pool_tags, struct kernel_pool_stats, entry )
+        {
+            buffer[copied++] = tag->stats;
+            if (copied == capacity) break;
+        }
+    }
+    if (capacity < count) set_error( STATUS_INFO_LENGTH_MISMATCH );
+}
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -67,6 +67,7 @@
 static DWORD client_tid;
 
 static HANDLE ntoskrnl_heap;
+DECLARE_CRITICAL_SECTION(pool_cs);
 
 static void *ldr_notify_cookie;
 
@@ -2252,8 +2253,31 @@
 void * WINAPI ExAllocatePool2( POOL_FLAGS flags, SIZE_T size, ULONG tag )
 {
     /* FIXME: handle page alignment constraints */
-    void *ret = HeapAlloc( ntoskrnl_heap, 0, size );
+    void *ret;
+
+    EnterCriticalSection( &pool_cs );
+    ret = HeapAlloc( ntoskrnl_heap, 0, size );
     TRACE( "(0x%I64x, %Iu, %s) -> %p\n", flags, size, debugstr_fourcc(tag), ret );
+    if (ret)
+    {
+        NTSTATUS status;
+        SERVER_START_REQ( update_kernel_pool )
+        {
+            req->address = wine_server_client_ptr( ret );
+            req->size = size;
+            req->tag = tag;
+            req->paged = !!(flags & POOL_FLAG_PAGED);
+            req->allocate = 1;
+            status = wine_server_call( req );
+        }
+        SERVER_END_REQ;
+        if (status)
+        {
+            HeapFree( ntoskrnl_heap, 0, ret );
+            ret = NULL;
+        }
+    }
+    LeaveCriticalSection( &pool_cs );
     return ret;
 }
 
@@ -2371,8 +2395,21 @@
  */
 void WINAPI ExFreePoolWithTag( void *ptr, ULONG tag )
 {
+    client_ptr_t address = wine_server_client_ptr( ptr );
+
     TRACE( "%p\n", ptr );
-    HeapFree( ntoskrnl_heap, 0, ptr );
+    EnterCriticalSection( &pool_cs );
+    if (ptr && HeapFree( ntoskrnl_heap, 0, ptr ))
+    {
+        SERVER_START_REQ( update_kernel_pool )
+        {
+            req->address = address;
+            req->allocate = 0;
+            if (wine_server_call( req )) WARN( "Untracked pool allocation %#I64x\n", address );
+        }
+        SERVER_END_REQ;
+    }
+    LeaveCriticalSection( &pool_cs );
 }
 
