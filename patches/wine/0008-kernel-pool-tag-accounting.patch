     switch (class)
     {
+
+    case SystemPoolTagInformation:
+    {
+        SYSTEM_POOLTAG_INFORMATION *pool = info;
+        struct kernel_pool_tag *tags;
+        unsigned int count = 0, copied = 0, i, capacity;
+
+        if (size && !virtual_check_buffer_for_write( info, size )) return STATUS_ACCESS_VIOLATION;
+        len = sizeof(*pool);
+        if (size < len)
+        {
+            ret = STATUS_INFO_LENGTH_MISMATCH;
+            break;
+        }
+        capacity = (size - offsetof(SYSTEM_POOLTAG_INFORMATION, TagInfo)) / sizeof(SYSTEM_POOLTAG);
+        if (!(tags = malloc( capacity * sizeof(*tags) ))) return STATUS_NO_MEMORY;
+        SERVER_START_REQ( get_kernel_pool_tags )
+        {
+            wine_server_set_reply( req, tags, capacity * sizeof(*tags) );
+            ret = wine_server_call( req );
+            count = reply->count;
+            copied = wine_server_reply_size( reply ) / sizeof(*tags);
+        }
+        SERVER_END_REQ;
+        if (!ret || ret == STATUS_INFO_LENGTH_MISMATCH)
+        {
+            len = max( sizeof(*pool), offsetof(SYSTEM_POOLTAG_INFORMATION, TagInfo) + count * sizeof(SYSTEM_POOLTAG) );
+            memset( pool, 0, min(size, len) );
+            pool->Count = count;
+            for (i = 0; i < copied; ++i)
+            {
+                pool->TagInfo[i].TagUlong = tags[i].tag;
+                pool->TagInfo[i].PagedAllocs = tags[i].paged_allocs;
+                pool->TagInfo[i].PagedFrees = tags[i].paged_frees;
+                pool->TagInfo[i].PagedUsed = tags[i].paged_used;
+                pool->TagInfo[i].NonPagedAllocs = tags[i].nonpaged_allocs;
+                pool->TagInfo[i].NonPagedFrees = tags[i].nonpaged_frees;
+                pool->TagInfo[i].NonPagedUsed = tags[i].nonpaged_used;
+            }
+        }
+        free( tags );
+        break;
+    }
     case SystemNativeBasicInformation:  /* 114 */
